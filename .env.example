# Render account settings -> API Keys -> create a new key
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The EXACT name you give your free Postgres instance every time you
# recreate it in the dashboard. Reuse this name every month so the
# script can always find "the current one".
RENDER_DB_NAME=myapp-db

# Your backend Web Service's ID (find it in the URL when viewing the
# service in the Render dashboard, or via GET /v1/services). Looks like srv-xxxxxxxxxxxx
RENDER_WEB_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx

# The env var name your backend reads the connection string from.
# Change this if your app uses something other than DATABASE_URL.
RENDER_ENV_VAR_KEY=DATABASE_URL

# Path to your local backup file, relative to this script.
BACKUP_FILE=./data.sql
